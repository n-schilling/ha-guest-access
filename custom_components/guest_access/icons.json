        "state": {
          "on": "mdi:account-group"
        }
      },
      "only_guests_home": {
        "default": "mdi:home-outline",
        "state": {
          "on": "mdi:home-account"
        }
      }
    },
    "event": {
      "activity": {
        "default": "mdi:account-clock"
      },
      "room_violation": {
        "default": "mdi:door-open"
      }
    },
    "sensor": {
